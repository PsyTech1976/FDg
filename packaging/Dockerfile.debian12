FROM debian:12-slim

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update -qq && apt-get install -y -qq \
    build-essential \
    cmake \
    qt6-base-dev \
    qt6-base-dev-tools \
    qt6-tools-dev \
    qt6-tools-dev-tools \
    qt6-qpa-plugins \
    libqt6svg6-dev \
    libgl1-mesa-dev \
    libdbus-1-dev \
    fd-find \
    python3 \
    file \
    binutils \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /workspace
